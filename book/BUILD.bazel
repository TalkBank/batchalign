"""Documentation with Bazel-managed mdBook, Mermaid, and linkcheck tools."""

load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

_BOOK_SRCS = glob(["book.toml", "src/**/*", "theme/**/*"], allow_empty = True)

[
    sh_binary(
        name = name,
        srcs = ["//bazel/book:run.sh"],
        args = [
            command,
            "$(rlocationpath @multitool//tools/mdbook)",
            "$(rlocationpath @multitool//tools/mdbook-mermaid)",
            "$(rlocationpath //bazel/book:linkcheck_tool)",
        ],
        data = _BOOK_SRCS + [
            "@multitool//tools/mdbook",
            "@multitool//tools/mdbook-mermaid",
            "//bazel/book:linkcheck_tool",
            "@bazel_tools//tools/bash/runfiles",
        ],
    )
    for name, command in [("serve", "serve"), ("html", "build"), ("linkcheck", "build")]
]
